# Sudoers configuration for AI Proxy
# Add this to /etc/sudoers using: sudo visudo

# Allow james user to manage systemd services for AI models
james ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop llama-*
james ALL=(ALL) NOPASSWD: /usr/bin/systemctl start llama-*
james ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart llama-*

# Allow james user to manage lact GPU profiles
james ALL=(ALL) NOPASSWD: /usr/bin/lact cli profile set *
